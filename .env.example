# ============================================================
# CREATORVERSE Event Platform – Environment Variables
# Copy these into Vercel → Project → Settings → Environment Variables
# NEVER commit real secrets to GitHub.
# ============================================================

# Required – Neon PostgreSQL connection string
# Get from: https://console.neon.tech → your project → Connection Details
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Required – random long string for session JWT signing
# Generate any long random string (e.g. 32+ characters)
AUTH_SECRET="replace-with-a-long-random-string"

# Required for one-time setup – choose any secret phrase
SETUP_SECRET="replace-with-your-setup-secret"

# Optional but recommended – Resend for confirmation emails
# Get from: https://resend.com → API Keys
RESEND_API_KEY="re_xxxxxxxx"
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Public site URL (used in email links). Set after first deploy.
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"
